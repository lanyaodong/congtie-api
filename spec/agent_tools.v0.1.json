
{
  "version": "0.1",
  "name": "xiaoge-agent-tools",
  "purpose": "The only allowed tool surface for external Agents/LLMs to call Xiaoge API. Agents MUST NOT access DB directly.",
  "base_url_env": "XIAOGE_API_BASE_URL",
  "default_base_url": "http://127.0.0.1:8000",
  "auth": {
    "type": "none",
    "note": "v0.1 has no auth. Add header-based auth in later versions."
  },
  "tools": [
    {
      "name": "health_check",
      "title": "Health Check",
      "description": "Check whether Xiaoge API is alive.",
      "method": "GET",
      "path": "/health",
      "request": {
        "content_type": "application/json",
        "schema": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      "response": {
        "content_type": "application/json",
        "schema": { "type": "object", "additionalProperties": true }
      }
    },
    {
      "name": "db_health_check",
      "title": "DB Health Check",
      "description": "Check whether Xiaoge API can connect to its database.",
      "method": "GET",
      "path": "/health/db",
      "request": {
        "content_type": "application/json",
        "schema": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      "response": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "db": { "type": ["string", "null"] },
            "select1": { "type": ["number", "null"] },
            "error": { "type": ["string", "null"] }
          },
          "required": ["ok"],
          "additionalProperties": true
        }
      }
    },
    {
      "name": "create_observation",
      "title": "Create Biomarker Observation",
      "description": "Create a biomarker observation record. This is the primary write endpoint for v0.1.",
      "method": "POST",
      "path": "/observations",
      "request": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "description": "UUID string" },
            "biomarker_code": { "type": "string" },
            "data_source_id": { "type": ["string", "null"], "description": "UUID string or null" },
            "observation_medium": {
              "type": "string",
              "enum": ["bio_sample", "device", "manual"]
            },
            "sample_type": {
              "type": ["string", "null"],
              "enum": ["blood", "urine", "stool", "saliva", "other", null]
            },
            "sample_method": {
              "type": ["string", "null"],
              "enum": ["venous", "capillary", "wearable", "lab", "other", null]
            },
            "sampling_context": { "type": ["object", "null"], "additionalProperties": true },
            "value_num": { "type": ["number", "null"] },
            "value_text": { "type": ["string", "null"] },
            "value_json": { "type": ["object", "null"], "additionalProperties": true },
            "unit": { "type": ["string", "null"] },
            "measured_at": {
              "type": "string",
              "description": "RFC3339 timestamp, recommended with Z suffix, e.g. 2026-03-03T06:32:46Z"
            },
            "freshness_state": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
            "accuracy_tier": { "type": "string", "enum": ["standard", "high", "unknown"] }
          },
          "required": [
            "user_id",
            "biomarker_code",
            "data_source_id",
            "observation_medium",
            "sample_type",
            "sample_method",
            "sampling_context",
            "value_num",
            "value_text",
            "value_json",
            "unit",
            "measured_at",
            "freshness_state",
            "accuracy_tier"
          ],
          "additionalProperties": false
        }
      },
      "response": {
        "content_type": "application/json",
        "schema": { "type": "object", "additionalProperties": true }
      },
      "errors": [
        { "status": 422, "meaning": "Validation error. Agent should log response body and fix request." },
        { "status": 500, "meaning": "Server error (often DB connectivity). Agent should run db_health_check." }
      ]
    }
  ],
  "rules": [
    "Agents MUST call only tools declared in this file.",
    "Agents MUST NOT attempt to infer DB schema or write SQL.",
    "The external contract is API endpoints + this tool spec. DB schema is not an API contract."
  ]
}
